    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.2.3-0 || >=0.2.3-0 <0.2.4-0 || >=0.2.4-0 <0.2.5-0 || >=0.2.5-0 <0.2.6-0 || >=0.2.6-0 <0.2.7-0 || >=0.2.7-0 <0.2.8-0 || >=0.2.8-0 <0.2.9-0 || >=0.2.9-0 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/dsh-skill": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.2-alpha.2",
    "handkey-client": "file:../handkey-client",
    "jsdom": "^26.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
